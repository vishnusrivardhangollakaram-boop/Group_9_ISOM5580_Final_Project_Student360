# Copy to secrets.toml locally, or paste the values into Streamlit Cloud Secrets.
# The delivered secrets.toml is already configured for your Student360 app.
DIFY_API_KEY = "your_student360_app_api_key"
DIFY_API_BASE_URL = "https://api.dify.ai/v1"
SCHOOL_ACCESS_CODE = "choose-your-school-access-code"

# Optional: select a writable database path when hosting outside Community Cloud.
# STUDENT360_DATABASE_PATH = "/absolute/writable/path/requests.sqlite3"
